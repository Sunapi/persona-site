{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "persona-site",
  "compatibility_date": "2026-07-30",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    {
      "pattern": "persona.od.ua",
      "custom_domain": true
    }
  ]
}
