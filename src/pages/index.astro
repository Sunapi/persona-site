---
const title = 'Persona — портфоліо';
const description = 'Персональний сайт-портфоліо. Незабаром тут з’являться нові роботи.';
---

<!doctype html>
<html lang="uk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#f4f1eb" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <p class="eyebrow">persona.od.ua</p>
      <h1>Портфоліо<br />в роботі.</h1>
      <p class="note">Незабаром тут з’являться нові роботи.</p>
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
    color: #171714;
    background: #f4f1eb;
    font-synthesis: none;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    min-height: 100%;
    margin: 0;
  }

  body {
    min-height: 100vh;
  }

  main {
    display: grid;
    min-height: 100vh;
    grid-template-rows: auto 1fr auto;
    padding: clamp(1.5rem, 4vw, 4rem);
  }

  .eyebrow,
  .note {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1 {
    align-self: center;
    margin: 0;
    max-width: 10ch;
    font-size: clamp(4rem, 12vw, 11rem);
    font-weight: 500;
    letter-spacing: -0.075em;
    line-height: 0.82;
  }

  .note {
    max-width: 34rem;
    letter-spacing: 0.08em;
    line-height: 1.6;
  }

  @media (max-width: 36rem) {
    h1 {
      font-size: clamp(3.7rem, 20vw, 6rem);
    }
  }
</style>
