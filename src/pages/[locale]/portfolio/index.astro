---
import PortfolioPage from '../../../components/pages/PortfolioPage.astro';
import { prefixedLocales } from '../../../i18n';

export function getStaticPaths() {
  return prefixedLocales.map((locale) => ({
    params: { locale },
    props: { locale },
  }));
}

const { locale } = Astro.props;
---

<PortfolioPage locale={locale} page={1} />
